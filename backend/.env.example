# ===== 数据库连接（云端优先，本地回退） =====
# 线上部署（Vercel）与推荐开发方式：使用公网托管 PostgreSQL，本机不再需要 openGauss。
# 设置 DATABASE_URL 后，下方 DB_* 全部被忽略。
#
# Neon（推荐，免费层够用）：
#   Dashboard → Connect → Pooled connection 复制（host 含 -pooler 后缀）
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require

# 本地 openGauss（离线开发选项）：注释掉上面的 DATABASE_URL 即回退到此处
DB_HOST=192.168.159.136
DB_PORT=7654
DB_NAME=aiapp
DB_USER=appuser
DB_PASSWORD=Secure@2026

# ===== 通用 =====
# JWT 签名密钥：必须用高强度随机串（如 crypto.randomBytes(48).toString('base64url')）。
# 留空或弱密钥时后端会拒绝启动。改串会令已签发 token 全部失效。
JWT_SECRET=
PORT=3003

# 允许跨域访问的前端来源（逗号分隔）。不填则默认仅本地开发地址
CORS_ORIGIN=http://localhost:5173

# 快讯同步鉴权（Vercel cron 用 CRON_SECRET 走 Bearer；手动触发用 SYNC_TOKEN 走 ?token=）
SYNC_TOKEN=change-me
CRON_SECRET=change-me

# ===== RSSHub（快讯采集依赖，自建 RSS 聚合服务） =====
# 快讯源（量子位 / 雷峰网 / AIbase / 智源社区）均经 RSSHub 路由取正文，
# 未配置或 RSSHub 不可达时，有原生 feed 的源自动回退，其余源本次跳过。
# 本地部署见 F:\RSSHub（npm start，默认端口 1200，需 Redis）。
# Vercel 部署无需配置该项（云端访问不到本机 RSSHub，会自动回退原生 feed）。
RSSHUB_BASE_URL=

# ===== Vercel（ai-app-backend 项目）需要配置的环境变量 =====
# DATABASE_URL  → Neon pooler 连接串（Production）
# JWT_SECRET    → 与本地一致或独立随机串（改串会令已发 token 全部失效）
# SYNC_TOKEN    → 手动触发 /api/news/sync 的 query token
# CRON_SECRET   → Vercel Cron 请求头 Authorization: Bearer <CRON_SECRET>，用于每日 08:30 自动采集
